# Copy this file to .env.local and fill in the key. .env.local is git-ignored; never commit a real key.
# Used only by the narration script for the marketing video (Sprint B, #29).
OPENAI_API_KEY=
# A dated snapshot, so a re-run sounds the same. gpt-4o-mini-tts is OpenAI's cheapest speech model that takes
# tone and accent instructions (about $0.015 a minute); OpenAI shuts it down on 6 January 2027.
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
