{
  "cues": [
    {
      "fragment": "f1",
      "scene": "hook",
      "start": 0,
      "end": 4.336,
      "lines": [
        "Amazon's experimental hiring tool",
        "allegedly ranked women lower."
      ]
    },
    {
      "fragment": "f1",
      "scene": "hook",
      "start": 4.336,
      "end": 6.47,
      "lines": [
        "Abandoning it took three years."
      ]
    },
    {
      "fragment": "f1",
      "scene": "problem",
      "start": 6.8,
      "end": 9.903,
      "lines": [
        "Today, no company can",
        "afford to spend such time"
      ]
    },
    {
      "fragment": "f1",
      "scene": "problem",
      "start": 9.903,
      "end": 13.005,
      "lines": [
        "and effort and end up",
        "potentially causing harm."
      ]
    },
    {
      "fragment": "f1",
      "scene": "problem",
      "start": 13.005,
      "end": 17.23,
      "lines": [
        "The challenge is to govern AI",
        "responsibly and create real value."
      ]
    },
    {
      "fragment": "f1",
      "scene": "canvas",
      "start": 18.3,
      "end": 23.219,
      "lines": [
        "In AI Center X, you start with the",
        "AI Canvas: the CV Screening Assistant's"
      ]
    },
    {
      "fragment": "f1",
      "scene": "canvas",
      "start": 23.219,
      "end": 26.809,
      "lines": [
        "business problem, its data,",
        "and the people it affects."
      ]
    },
    {
      "fragment": "f1",
      "scene": "canvas",
      "start": 26.809,
      "end": 28.67,
      "lines": [
        "Then you simulate the risks."
      ]
    },
    {
      "fragment": "f2",
      "scene": "risks",
      "start": 0,
      "end": 2.724,
      "lines": [
        "An AI agent suggests risks, each cited"
      ]
    },
    {
      "fragment": "f2",
      "scene": "risks",
      "start": 2.724,
      "end": 7.097,
      "lines": [
        "from the MIT AI Risk Repository",
        "and the AI Incident Database."
      ]
    },
    {
      "fragment": "f2",
      "scene": "risks",
      "start": 7.097,
      "end": 10.179,
      "lines": [
        "You select the relevant",
        "ones and save them."
      ]
    },
    {
      "fragment": "f2",
      "scene": "risks",
      "start": 10.179,
      "end": 12.33,
      "lines": [
        "Now, generate the mitigations."
      ]
    },
    {
      "fragment": "f3",
      "scene": "mitigations",
      "start": 0,
      "end": 3.9,
      "lines": [
        "For every saved risk,",
        "the agent proposes mitigations,"
      ]
    },
    {
      "fragment": "f3",
      "scene": "mitigations",
      "start": 3.9,
      "end": 8.535,
      "lines": [
        "each classed by MIT's draft",
        "taxonomy and tied to the EU AI Act."
      ]
    },
    {
      "fragment": "f3",
      "scene": "mitigations",
      "start": 8.535,
      "end": 10.522,
      "lines": [
        "Again, you select and save."
      ]
    },
    {
      "fragment": "f3",
      "scene": "mitigations",
      "start": 10.522,
      "end": 12.95,
      "lines": [
        "Next come the model enhancements."
      ]
    },
    {
      "fragment": "f4",
      "scene": "enhancements",
      "start": 0,
      "end": 3.299,
      "lines": [
        "The agent shows how to put",
        "those mitigations into effect:"
      ]
    },
    {
      "fragment": "f4",
      "scene": "enhancements",
      "start": 3.299,
      "end": 6.483,
      "lines": [
        "fine-tuning on audited shortlists,",
        "two checking agents,"
      ]
    },
    {
      "fragment": "f4",
      "scene": "enhancements",
      "start": 6.483,
      "end": 9.087,
      "lines": [
        "and learning from audited",
        "recruiter feedback."
      ]
    },
    {
      "fragment": "f4",
      "scene": "enhancements",
      "start": 9.087,
      "end": 10.65,
      "lines": [
        "You save the ones you need."
      ]
    },
    {
      "fragment": "f5",
      "scene": "end",
      "start": 0,
      "end": 2.458,
      "lines": [
        "From idea to business value."
      ]
    },
    {
      "fragment": "f5",
      "scene": "end",
      "start": 2.458,
      "end": 5.53,
      "lines": [
        "AI Center X: make AI deliver value."
      ]
    }
  ]
}
