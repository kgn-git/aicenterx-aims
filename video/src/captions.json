    },
    {
      "fragment": "f1",
      "scene": "canvas",
      "start": 15.676,
      "end": 19.136,
      "lines": [
        "Map your initiative",
        "on the AI Canvas: its business"
      ]
    },
    {
      "fragment": "f1",
      "scene": "canvas",
      "start": 19.136,
      "end": 22.181,
      "lines": [
        "problem, its data",
        "and the people it affects."
      ]
    },
    {
      "fragment": "f2",
      "scene": "risks",
      "start": 0,
      "end": 4.128,
      "lines": [
