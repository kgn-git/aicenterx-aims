        "on audited shortlists,"
      ]
    },
    {
      "fragment": "f4",
      "scene": "enhancements",
      "start": 5.4,
      "end": 8.532,
      "lines": [
        "two checking agents, and learning",
        "from recruiter feedback."
      ]
    },
    {
      "fragment": "f4",
      "scene": "enhancements",
      "start": 8.532,
      "end": 9.99,
      "lines": [
        "You save the ones you need."
      ]
    },
    {
      "fragment": "f5",
      "scene": "end",
      "start": 0,
      "end": 1.871,
      "lines": [
        "From idea to governed initiative."
      ]
    },
    {
      "fragment": "f5",
      "scene": "end",
      "start": 1.871,
