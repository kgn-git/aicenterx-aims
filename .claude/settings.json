{
  "permissions": {
    "allow": [
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project list *)",
      "Bash(gh project view *)",
      "Bash(gh label list *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "3c hook run --event=PreToolUse",
            "timeout": 12
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "3c hook path-guard",
            "timeout": 12
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "3c hook run --event=PostToolUse",
            "timeout": 12
          }
        ]
      }
    ]
  }
}
